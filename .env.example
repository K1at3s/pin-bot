# Standalone Pin Bot Environment Variables
# Bu dosya örneğidir; .env olarak kopyalayıp değerleri doldurun.

# Discord Bot Token (ZORUNLU)
# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# MongoDB Bağlantı URI'si (ZORUNLU)
# Yerel: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://username:password@cluster0.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Veritabanı ismi (İSTEĞİ BAĞLI, varsayılan: ticket_bot)
MONGODB_DATABASE=ticket_bot

# Bot komut önekki (İSTEĞİ BAĞLI, varsayılan: .)
PREFIX=.

# Staff/Rol ID (İSTEĞİ BAĞLI)
# Pin takibinden muaf rolün ID'si
PIN_TRACKER_ROLE_ID=

# Ignored channel IDs (İSTEĞİ BAĞLI, virgleyle ayrı)
# Pin sayımından dış kanalların ID'leri
IGNORED_CHANNEL_IDS=

# Botu aktif/pasif (İSTEĞİ BAĞLI, varsayılan: true)
PIN_TRACKER_ENABLED=true